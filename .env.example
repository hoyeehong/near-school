# The app starts without credentials in a clearly labelled fixture mode.
DATA_MODE=demo
AI_MODE=demo
DATABASE_URL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Explicitly check model availability in your Vertex project before enabling AI.
VERTEX_MODEL=gemini-3.5-flash-lite
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
ONEMAP_TOKEN=
SNAPSHOT_BUCKET=
AI_MONTHLY_BUDGET_SGD=30
# Each call reserves its bounded maximum cost; configure from current model prices.
AI_REQUEST_RESERVATION_SGD=0.25
RATE_LIMIT_SALT=replace-with-a-random-secret
# Official address-school classifications are imported from an authorised source.
OFFICIAL_DISTANCE_SOURCE_URL=
OFFICIAL_DISTANCE_REUSE_APPROVED=false
