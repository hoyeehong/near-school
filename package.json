{
  "name": "p1-neighbourhood-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "data:refresh": "node --import tsx scripts/refresh.ts",
    "data:publish": "node --import tsx scripts/publish.ts",
    "eval": "node --import tsx scripts/evaluate.ts",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.23.0",
    "csv-parse": "^7.0.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    }
  }
}
